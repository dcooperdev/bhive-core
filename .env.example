# Selects which built-in LLMAdapter BeeManager auto-constructs when no
# llmAdapter/llmProvider is given explicitly. One of: gemini, openai,
# anthropic, ollama. Defaults to "gemini" if unset or unrecognized.
LLM_PROVIDER=gemini

# --- Gemini (Google) ---------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Ollama (local/self-hosted) -------------------------------------------
# No API key needed. Defaults to http://localhost:11434 if unset.
OLLAMA_BASE_URL=http://localhost:11434

# --- Timeouts (milliseconds) --------------------------------------------
# Per-request timeout for the LLM call. Applies to both the HTTP request and
# the Bee-level wrapper. Resolution order, most specific first:
#   adapter/BeeManager argument  >  <PROVIDER>_TIMEOUT  >  BEE_TIMEOUT  >  default
# Defaults: 60000 (60s) for hosted providers, 120000 for Ollama.
# Raise these if you hit "Timeout after 60000ms" on slow networks / large jobs.
# BEE_TIMEOUT=60000          # generic fallback for whichever provider is active
# GEMINI_TIMEOUT=60000
# OPENAI_TIMEOUT=60000
# ANTHROPIC_TIMEOUT=60000
# OLLAMA_TIMEOUT=120000      # local models are slower; bump to 180000 if needed
